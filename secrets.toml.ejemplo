# Copia este archivo como .streamlit/secrets.toml (local) o pégalo en
# Streamlit Cloud > Settings > Secrets para configurar los usuarios del ERP
# y, opcionalmente, la base de datos PostgreSQL.
#
# Puedes agregar tantos usuarios como quieras.

[usuarios]
admin = "cambia-esta-clave"

# Opcional: si defines database_url, la app usa PostgreSQL en lugar de SQLite.
# Si la dejas comentada o ausente, la app sigue funcionando con SQLite local.
# database_url = "postgresql://usuario:clave@host/dbname?sslmode=require"
